# ============================================================
# Core runtime
# ============================================================
APP_ENV=development
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s

# Browser origins allowed to call customer-facing endpoints.
# Required explicitly in production.
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated proxy IPs/CIDRs trusted by Gin for client IP headers.
# Leave blank when the API is not behind a trusted reverse proxy.
TRUSTED_PROXIES=

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SSLMODE=disable

# ============================================================
# Redis
# ============================================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# Customer authentication
# ============================================================
# Development registration OTPs are written to the API log.
# Production fails closed until a real SMS provider is integrated.
AUTH_OTP_ENABLED=true
AUTH_ALLOW_UNVERIFIED_SIGNUP=false

# ============================================================
# Admin authentication / MFA
# ============================================================
ADMIN_ENCRYPTION_KEY_ID=example-admin-key-v1

# Development-only example AES-256 key (32 zero bytes, base64 encoded).
# Replace this with a real generated secret outside local development.
ADMIN_ENCRYPTION_KEY_BASE64=CHANGE_ME_BASE64
ADMIN_TOTP_ISSUER=Commerce Admin
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_ALLOWED_NETWORKS=
ADMIN_COOKIE_DOMAIN=

# ============================================================
# Invoice identity
# ============================================================
# INVOICE_MERCHANT_NAME is required.
# At least one of INVOICE_BUSINESS_EMAIL or INVOICE_MERCHANT_EMAIL
# must be set to a valid bare email address.
INVOICE_MERCHANT_NAME=Commerce
INVOICE_MERCHANT_EMAIL=merchant@example.com
INVOICE_MERCHANT_PHONE=
INVOICE_MERCHANT_ADDRESS_LINE1=
INVOICE_MERCHANT_ADDRESS_LINE2=
INVOICE_MERCHANT_CITY=
INVOICE_MERCHANT_COUNTRY=Bangladesh
INVOICE_BUSINESS_EMAIL=finance@example.com

# ============================================================
# Payment methods
# ============================================================
COD_ENABLED=true
BKASH_ENABLED=false
NAGAD_ENABLED=false
ROCKET_ENABLED=false
BANK_TRANSFER_ENABLED=false

# Order/payment expiry scheduler
PAYMENT_EXPIRY_INTERVAL=30s
PAYMENT_EXPIRY_BATCH_SIZE=100

# Provider payment reconciliation scheduler
PAYMENT_RECONCILIATION_INTERVAL=30s
PAYMENT_RECONCILIATION_BATCH_SIZE=100

# ============================================================
# Notification outbox scheduler
# ============================================================
NOTIFICATION_OUTBOX_INTERVAL=5s
NOTIFICATION_OUTBOX_BATCH_SIZE=100

# ============================================================
# Worker tuning
# ============================================================
WORKER_CONCURRENCY=4
WORKER_PREFETCH=16
WORKER_QUEUE_BLOCK=2s
WORKER_HANDLER_TIMEOUT=2m
WORKER_CLAIM_MIN_IDLE=5m
WORKER_CLAIM_INTERVAL=30s
WORKER_RETRY_POLL_INTERVAL=1s

# ============================================================
# Checkout delivery methods
# ============================================================
DELIVERY_CURRENCY=BDT

DELIVERY_STANDARD_ENABLED=true
DELIVERY_STANDARD_FEE_AMOUNT=0
DELIVERY_STANDARD_MIN_ETA=48h
DELIVERY_STANDARD_MAX_ETA=96h

DELIVERY_SAME_DAY_ENABLED=false
DELIVERY_SAME_DAY_FEE_AMOUNT=0
DELIVERY_SAME_DAY_MIN_ETA=4h
DELIVERY_SAME_DAY_MAX_ETA=12h

DELIVERY_PRIORITY_ENABLED=false
DELIVERY_PRIORITY_FEE_AMOUNT=0
DELIVERY_PRIORITY_MIN_ETA=24h
DELIVERY_PRIORITY_MAX_ETA=48h

# ============================================================
# Object storage
# ============================================================
# Supported values: disabled, s3
STORAGE_PROVIDER=disabled
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_UPLOAD_URL_TTL=15m
STORAGE_DOWNLOAD_URL_TTL=15m

# ============================================================
# Product semantic search
# ============================================================
SEARCH_SEMANTIC_ENABLED=false
SEARCH_EMBEDDING_MODEL=voyage-multimodal-3.5
SEARCH_EMBEDDING_TIMEOUT=10s
SEARCH_SEMANTIC_PRIMARY_MIN=0.62
SEARCH_SEMANTIC_SIMILAR_MIN=0.50
VOYAGE_API_KEY=

# ============================================================
# Prometheus metrics
# ============================================================
# Development defaults to enabled; production defaults to disabled.
# When enabled in production, METRICS_TOKEN must be at least 32 chars.
METRICS_ENABLED=true
METRICS_PATH=/internal/metrics
METRICS_TOKEN=

# ============================================================
# Optional bootstrap command inputs
# ============================================================
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=

SUPPORT_BOOTSTRAP_NAME=
SUPPORT_BOOTSTRAP_EMAIL=
SUPPORT_BOOTSTRAP_PHONE=
SUPPORT_BOOTSTRAP_PASSWORD=
